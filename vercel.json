{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/articles",      "destination": "/articles.html" },
    { "source": "/all-articles",  "destination": "/articles.html" },
    { "source": "/blog",          "destination": "/articles.html" },
    { "source": "/mantras",       "destination": "/mantras.html" },
    { "source": "/puja-vidhi",    "destination": "/puja-vidhi.html" },
    { "source": "/geeta-gyan",    "destination": "/geeta-gyan.html" },
    { "source": "/vrat-festivals","destination": "/vrat-festivals.html" },
    { "source": "/dev-katha",             "destination": "/dev-katha.html" },
    { "source": "/donate",                "destination": "/donate.html" },
    { "source": "/about",                 "destination": "/about.html" },
    { "source": "/contact",               "destination": "/contact.html" },
    { "source": "/privacy-policy",        "destination": "/privacy-policy.html" },
    { "source": "/disclaimer",            "destination": "/disclaimer.html" },
    { "source": "/terms",                 "destination": "/terms.html" },
    { "source": "/editorial-policy",      "destination": "/editorial-policy.html" },
    { "source": "/affiliate-disclosure",  "destination": "/affiliate-disclosure.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; media-src 'self'; connect-src 'self' https://www.google-analytics.com; frame-ancestors 'self';"
        }
      ]
    },
    {
      "source": "/theme-premium/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/styles/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/scripts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
